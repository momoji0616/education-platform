# 统一环境变量示例
# 复制后按实际环境填写，不要把真实密钥提交到仓库

# Spring Boot -> FastAPI 代理地址
EDUCATION_AI_BASE_URL=http://127.0.0.1:8000

# Spring Boot 数据库配置
DB_URL=jdbc:mysql://127.0.0.1:3306/ry-vue?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
DB_USERNAME=root
DB_PASSWORD=

# FastAPI 大模型密钥
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_API_KEY=your_qwen_api_key

# FastAPI 数据库配置（如启用数据库存储）
AI_DB_HOST=127.0.0.1
AI_DB_PORT=3306
AI_DB_NAME=ry-vue
AI_DB_USER=root
AI_DB_PASSWORD=your_db_password

# 前端标题示例
VITE_APP_TITLE=基于RAG的个性化智能教育辅助系统
